 * SPDX-License-Identifier: MIT
 *
 * ai_companion keymap.
 *
 * Encoder rotation = REAL function: mouse-wheel scroll (scroll the focused
 * window on the Mac, e.g. the Optimus session window). This is a generic HID
 * scroll, handled natively by macOS — no host app required.
 *   Encoder turn -> right = Scroll Up, left = Scroll Down
 *
 * The 4 buttons use PLACEHOLDER test keycodes for wiring verification; Phase 5
 * replaces these with the real Mac <-> device signalling:
 *   Voice -> V,  Yes -> Y,  No -> N,  Open -> O
 *
 * The DRV2605L haptic motor is HW-verified (2026-09-28); it will be driven by
 * host commands in Phase 5, not by a physical button, so the Open button is
 * bound to its normal placeholder keycode (&kp O). The `&haptic` behavior stays
 * defined in the devicetree (node drv2605@5a) ready for Phase 5 host control.
 *
 * The rotary encoder is a 4-pin module (SIGA/SIGB/VCC/GND) whose push switch is
 * not routed to the header, so only rotation is used (no encoder-push button).
 *
 * How to verify (no physical buttons needed): open any text field, then briefly
 * touch each pin to GND with a jumper -> the matching letter is typed. Once the
 * physical encoder is fitted, turning it scrolls the focused window.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Raise the default mouse-scroll speed BEFORE including pointing.h so SCRL_UP /
 * SCRL_DOWN carry a larger value. `&msc` (zmk,behavior-input-two-axis) is a
 * VELOCITY behavior: distance = speed x hold-time, accrued once per
 * trigger-period-ms tick. A sensor-rotate "tap" is far too short at the default
 * speed (10) so a detent scrolled ~0. See the &msc override + tap-ms below.
 */
#define ZMK_POINTING_DEFAULT_SCRL_VAL 60
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        // Sensor-rotate behaviour: 1st binding = clockwise, 2nd = counter-clockwise.
        // Direction can be swapped after testing with the real encoder + macOS
        // "natural scrolling" setting.
        // tap-ms holds &msc long enough for several scroll ticks per detent:
        // ticks fire every trigger-period-ms (=10, overridden below), so a 50ms
        // hold ≈ 5 ticks; distance ≈ speed(60) x 10ms/1000 x 5 ≈ 3 wheel units.
        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;
            tap-ms = <50>;
        };
    };
};

/*
 * Make &msc react immediately and tick finely so a short per-detent hold still
 * produces a clean, perceptible scroll (defaults: trigger-period 16ms,
 * time-to-max-speed 300ms → a tap accrued nothing). acceleration-exponent is
 * already 0 (constant speed) in the stock node.
 */
&msc {
    trigger-period-ms = <10>;
    time-to-max-speed-ms = <0>;
    delay-ms = <0>;
};

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "AICompanion";
            bindings = <
                &kp V   &kp Y   &kp N   &out OUT_TOG
            >;
            // Encoder rotation = mouse-wheel scroll (real function: scroll the
            // focused Mac/Optimus window). Rotation hardware HW-verified 2026-09-28
            // via the volume-diagnostic build (turning changed macOS volume).
            sensor-bindings = <&encoder_scroll>;
        };
    };
};
