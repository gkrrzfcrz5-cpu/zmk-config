 * Copyright (c) 2026 The AI Companion Contributors
 * SPDX-License-Identifier: MIT
 *
 * ai_companion shield for the Seeed XIAO nRF52840 (seeed_xiao interconnect).
 * Phase 3: 4 push buttons + EC11 rotary encoder (rotation + push switch).
 *
 * Pin allocation (XIAO digital pins, referenced as `&xiao_d N` = XIAO pin DN):
 *   D0  Voice button        (direct GPIO, active-low, internal pull-up)
 *   D1  Yes   button        (direct GPIO, active-low, internal pull-up)
 *   D2  No    button        (direct GPIO, active-low, internal pull-up)
 *   D3  Open  button        (direct GPIO, active-low, internal pull-up)
 *   D6  Encoder push switch (direct GPIO, active-low, internal pull-up)
 *   D7  Encoder A phase     (EC11)
 *   D8  Encoder B phase     (EC11)
 *   D4/D5 reserved for I2C  (OLED SSD1306 + DRV2605L haptic) - Phase 4
 *   D9  reserved for DRV2605L EN (enable) - Phase 4
 *   D10 spare
 *
 * Buttons wire between the listed pin and GND; the internal pull-up means no
 * external resistor is required. The EC11 A/B pins also use internal pull-ups,
 * so an *unconnected* encoder reads a stable high level and produces no spurious
 * events (safe to build before the encoder hardware is fitted).
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <1>;
        //        Voice   Yes     No      Open    EncPush
        map = < RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Voice
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Yes
            , <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // No
            , <&xiao_d 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Open
            , <&xiao_d 6 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Encoder push
            ;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 8 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };
};
