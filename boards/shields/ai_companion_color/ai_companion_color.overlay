/*
 * Copyright (c) 2026 The AI Companion Contributors
 * SPDX-License-Identifier: MIT
 *
 * ai_companion_color shield — the COLOUR build of the AI Companion device.
 *
 * Same firmware LOGIC as the mono `ai_companion` shield (4 buttons + EC11
 * encoder + DRV2605L haptic + USB CDC-ACM data channel + the custom 12-screen
 * status UI), but:
 *   1) the display is a Waveshare 2.4" ILI9341 IPS panel (240x320, 4-wire SPI)
 *      instead of the 128x64 I2C SSD1306, and
 *   2) the rotary encoder's push switch (SW) is now wired as a 5th button.
 *
 * BOARD: still `seeeduino_xiao_ble` — but the physical board is the XIAO
 * nRF52840 *Plus* (20 pins, D0-D19). The SoC is identical, so no new board
 * definition is needed; the extra pins (D11+) are reached with raw &gpio0 /
 * &gpio1 references plus a pinctrl override on the SPI bus. The regular XIAO's
 * 11-pin header (D0-D10) does NOT expose enough pins for panel + 5 buttons +
 * encoder + haptic, so this shield REQUIRES the Plus.
 *
 * VERIFICATION LEVEL: NOT YET HW-VERIFIED on this panel (bring-up pending — the
 * 1.9" ST7789 build was verified; this is the 2.4" ILI9341 swap). The ILI9341
 * driver supplies its own register defaults; the only panel-specific choices
 * here are 8 MHz SPI (dupont jumpers ring higher -> fuzzy text) and the LANDSCAPE
 * orientation (rotation = 270). The exact rotation direction is confirmed at
 * bring-up (see the node below).
 *
 * ---- Pin map (XIAO Plus digital pin -> nRF GPIO; source = Seeed variant.cpp) ----
 *   Existing 8 signals — UNCHANGED from the mono shield:
 *     D0  Voice button       (P0.02)   direct GPIO, active-low, pull-up
 *     D2  Yes   button       (P0.28)   direct GPIO, active-low, pull-up
 *     D9  No    button       (P1.14)   direct GPIO, active-low, pull-up
 *     D10 Open  button       (P1.15)   direct GPIO, active-low, pull-up
 *     D7  Encoder A          (P1.12)   EC11
 *     D6  Encoder B          (P1.11)   EC11
 *     D4  I2C SDA            (P0.04)   DRV2605L haptic
 *     D5  I2C SCL            (P0.05)   DRV2605L haptic
 *   New signals — only on pins the mono build left free:
 *     D8  Screen CLK (SCK)   (P1.13)   SPI2 — native SCK pin, no override needed
 *     D11 Screen DIN (MOSI)  (P0.15)   SPI2 — MOSI moved here (native P1.15 = D10 = Open)
 *     D12 Screen CS          (P0.19)   SPI2 chip-select GPIO
 *     D13 Screen DC          (P1.01)   command/data select GPIO
 *     D17 Screen RST         (P1.07)   reset GPIO
 *   Encoder push switch — moved off the hard-to-reach Plus back-pad D19 (P1.03)
 *   onto a free top-header pin (2026-09-30 bring-up: D19 back-pad would not
 *   register even shorted straight to GND, while D0 fired instantly):
 *     D1  Encoder SW (push)  (P0.03)   direct GPIO, active-low, pull-up (5th button)
 *   Screen BL -> 3V3 (always on); VCC -> 3V3; GND -> GND; MISO not connected.
 *   AVOIDED: D14/D15 (P0.09/P0.10 = NFC pins), D16 (P0.31 = VBAT sense).
 */

#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
        zephyr,display = &ili9341_color;   // colour panel replaces the OLED
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <5>;
        rows = <1>;
        //        Voice   Yes     No      Open    EncSW
        map = < RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        wakeup-source;
        debounce-press-ms = <5>;
        debounce-release-ms = <5>;
        input-gpios
            = <&xiao_d 0  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Voice
            , <&xiao_d 2  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Yes
            , <&xiao_d 9  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // No
            , <&xiao_d 10 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Open
            , <&xiao_d 1  (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>   // Encoder SW = D1 (P0.03)
            ;
    };

    encoder: encoder {
        compatible = "alps,ec11";
        a-gpios = <&xiao_d 7 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&xiao_d 6 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&encoder>;
        triggers-per-rotation = <20>;
    };

    /*
     * Soft-off wakeup sources. When &soft_off (bound to the Yes+Open combo in
     * the keymap) powers the chip into System OFF, ZMK keeps the devices listed
     * here alive so they can wake it again. kscan0 already carries
     * `wakeup-source;` and is a direct GPIO kscan, so listing it here is the ZMK
     * docs' simplest path: pressing ANY of the 5 keys (Voice/Yes/No/Open/EncSW)
     * wakes the device — no dedicated gpio-key / sideband node needed.
     */
    soft_off_wakers {
        compatible = "zmk,soft-off-wakeup-sources";
        wakeup-sources = <&kscan0>;
    };
};

/*
 * Colour panel — Waveshare 2.4" ILI9341 (240x320, 4-wire SPI), on the XIAO's
 * SPI2 (`xiao_spi`). SPI2's native pins are SCK=P1.13, MOSI=P1.15, MISO=P1.14.
 * We keep SCK on P1.13 (= D8, free) but MOVE MOSI off P1.15 — that pin is D10,
 * the Open button — onto P0.15 (= D11). MISO is dropped: the display is
 * write-only. This override is a per-shield pinctrl state so the board's stock
 * spi2_default is left intact for anything else.
 */
&pinctrl {
    spi2_default_color: spi2_default_color {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 15)>;
        };
    };

    spi2_sleep_color: spi2_sleep_color {
        group1 {
            psels = <NRF_PSEL(SPIM_SCK, 1, 13)>,
                    <NRF_PSEL(SPIM_MOSI, 0, 15)>;
            low-power-enable;
        };
    };
};

&xiao_spi {
    status = "okay";
    pinctrl-0 = <&spi2_default_color>;
    pinctrl-1 = <&spi2_sleep_color>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 19 GPIO_ACTIVE_LOW>;   // CS = D12 (P0.19)

    /*
     * ILI9341 node (Waveshare 2.4"). Unlike the old ST7789 node, the Zephyr
     * ILI9341 driver (shared drivers/display/display_ili9xxx.c) already carries
     * sensible defaults for EVERY power/gamma/VCOM/frame register in its binding
     * (dts/bindings/display/ilitek,ili9341.yaml), so none of those arrays need
     * to be restated here — this node is just bus + control pins + orientation.
     *
     * Resolution is FIXED inside the driver (ILI9341 = 240x320 portrait, from
     * its X_RES/Y_RES macros); width/height below are only there because the
     * binding marks them required (display-controller.yaml) — the driver ignores
     * them for resolution. `rotation = <270>` turns it to LANDSCAPE 320x240 for
     * the horizontal-bar enclosure and programs MADCTL for us — no manual mdac /
     * offset. pixel-format <0> = RGB565 (matches CONFIG_LV_COLOR_DEPTH_16).
     */
    ili9341_color: ili9341@0 {
        compatible = "ilitek,ili9341";
        reg = <0>;
        /*
         * 8 MHz. The panel is wired with dupont jumpers; faster rates on long
         * unshielded leads ring/couple and show up as fuzzy/ghosted pixels.
         * Raise once the panel is on a proper flex/PCB with short traces.
         */
        spi-max-frequency = <8000000>;
        cmd-data-gpios = <&gpio1 1 GPIO_ACTIVE_LOW>;   // DC  = D13 (P1.01)
        reset-gpios    = <&gpio1 7 GPIO_ACTIVE_LOW>;   // RST = D17 (P1.07)
        pixel-format = <0>;    // 0 = RGB565
        /*
         * width/height are REQUIRED by the binding (inherited from
         * display-controller.yaml) but the ili9xxx driver does NOT use them for
         * resolution — it takes that from its own ILI9341_X_RES/Y_RES macros
         * (240x320) and swaps per `rotation`. So these are the native-panel
         * values purely to satisfy the binding; the live resolution is driven by
         * rotation below (270 -> landscape 320x240).
         */
        width = <240>;
        height = <320>;
        /*
         * 270 = landscape 320x240. If the image comes up upside-down / mirrored
         * at bring-up, try 90 instead — both are landscape, 180 deg apart.
         */
        rotation = <270>;
    };
};

/*
 * Haptic + I2C — identical to the mono shield. The DRV2605L stays on the XIAO
 * I2C bus (D4=SDA / D5=SCL). No SSD1306 node here: the colour panel replaces it.
 */
&xiao_i2c {
    status = "okay";

    haptic: drv2605@5a {
        compatible = "aic,behavior-haptic";
        reg = <0x5a>;
        #binding-cells = <0>;
    };
};

/*
 * USB CDC-ACM data channel — identical to the mono shield (host <-> device
 * newline-delimited JSON over a virtual serial port alongside USB HID).
 */
&zephyr_udc0 {
    aic_comm_uart: aic_comm_uart {
        compatible = "zephyr,cdc-acm-uart";
    };
};

/ {
    chosen {
        aic,comm-uart = &aic_comm_uart;
    };
};

/*
 * ---- Backlight control (BL = D18 = P1.05) ----
 * The Waveshare 2.4" panel's BL pin is a LOGIC control input (BL -> R5 1K -> NPN
 * base, with R6 10K on the base, switching the LED current), NOT an LED-current
 * pin — so an nRF GPIO/PWM can drive it directly, no MOSFET. The BL net goes to
 * P1.05; driving it from PWM0 gives real control: high = lit, low = dark. ZMK
 * backlight defaults to on-at-boot at 100%. (Unlike the 1.9" panel there is no
 * TXS0108 pull-up forcing it on, so floating-pin behaviour differs — see the
 * soft-off HARDWARE NOTE in the .conf.)
 *
 * VERIFY: hold Voice + Open -> &bl BL_TOG (see keymap). The panel going DARK is
 * the proof firmware owns P1.05.
 */
#include <dt-bindings/pwm/pwm.h>

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 5)>;   // BL = D18 (P1.05)
        };
    };

    pwm0_sleep: pwm0_sleep {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 1, 5)>;
            low-power-enable;
        };
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};

/ {
    backlight: pwmleds {
        compatible = "pwm-leds";
        pwm_led_0 {
            pwms = <&pwm0 0 PWM_MSEC(10) PWM_POLARITY_NORMAL>;
        };
    };

    chosen {
        zmk,backlight = &backlight;
    };
};
