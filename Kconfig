# Kconfig for the in-repo module (referenced by zephyr/module.yml `kconfig:`).

config ZMK_BEHAVIOR_HAPTIC
    bool "DRV2605L haptic trigger behavior"
    default y
    depends on DT_HAS_AIC_BEHAVIOR_HAPTIC_ENABLED
    select I2C
    help
      Custom ZMK behavior that fires a DRV2605L one-shot haptic effect over raw
      I2C. Auto-enabled when an `aic,behavior-haptic` devicetree node is present.

DT_CHOSEN_AIC_COMM_UART := aic,comm-uart

config AIC_COMM
    bool "AI Companion host communication (USB CDC-ACM JSON channel)"
    default y if $(dt_chosen_enabled,$(DT_CHOSEN_AIC_COMM_UART))
    help
      Host <-> device communication over a USB CDC-ACM virtual serial port,
      exchanging newline-delimited JSON (see docs/phase5-interface-contract.md).
      The host pushes `screen`/`haptic`/`tasks`/`ping`; the device replies with
      `input`/`hello`/`pong` and drives the LVGL status screen + DRV2605L haptic.
      Auto-enabled when the `aic,comm-uart` chosen node is present. The required
      USB CDC / SERIAL / UART symbols are turned on in the shield .conf.

config ZMK_BEHAVIOR_AIC_INPUT
    bool "AI Companion physical-button input behavior"
    default y
    depends on DT_HAS_AIC_BEHAVIOR_INPUT_ENABLED && AIC_COMM
    help
      Custom ZMK behavior bound to the 4 buttons (Voice/Yes/No/Open). On press it
      reports the button + current screen state/id to the host as an `input`
      message over the CDC channel (src/behavior_input.c -> aic_comm_send_input).
      Requires AIC_COMM. Auto-enabled when an `aic,behavior-input` node is
      present (the ai_companion keymap defines one).

